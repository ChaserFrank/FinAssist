# Copy this file to .env for local development.
# Never commit a real .env file.

# --- Application ---
APP_ENV=local
APP_NAME=FinAssist
LOG_LEVEL=INFO

# --- Database ---
# When running via Docker Compose, this matches the `postgres` service below.
DATABASE_URL=postgresql+psycopg://finassist:finassist@postgres:5432/finassist

# --- watsonx.ai (leave empty until IBM TechZone credentials are available) ---
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# --- Watson Orchestrate (leave empty until IBM TechZone credentials are available) ---
ORCHESTRATE_URL=
ORCHESTRATE_API_KEY=

# --- PostgreSQL (used by the `postgres` Docker Compose service) ---
POSTGRES_USER=finassist
POSTGRES_PASSWORD=finassist
POSTGRES_DB=finassist
