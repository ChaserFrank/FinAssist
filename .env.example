# Copy this file to `.env` and fill in the blanks. `.env` is git-ignored.
# NEVER commit real credentials -- see docs/security.md.
#
# Generate a strong, URL-safe database password with:
#     openssl rand -hex 16

# --- Application ---
APP_ENV=local
APP_NAME=FinAssist
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (used by docker-compose.yml; you choose these values) ---
POSTGRES_USER=finassist
POSTGRES_PASSWORD=
POSTGRES_DB=finassist

# --- Database URL ---
# With Docker Compose you do NOT set this: compose builds it from the
# POSTGRES_* values above. Only set it when running the backend directly on
# your host (outside Docker), using your own values:
#   DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database>

# --- watsonx.ai (leave empty until IBM TechZone credentials are available) ---
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# --- Watson Orchestrate (leave empty until IBM TechZone credentials are available) ---
ORCHESTRATE_URL=
ORCHESTRATE_API_KEY=
